# OpenAI-compatible chat completions endpoint.
# Use the exact endpoint URL supplied by your chosen AI provider.
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=replace-with-provider-key
AI_MODEL=replace-with-model-name
AI_SYSTEM_PROMPT=You are XENO, a helpful personal AI assistant.

# Required for POST /chat. Development-only shared token.
# Do not hardcode this value into a production Android APK.
XENO_API_TOKEN=replace-with-a-long-random-token

# CORS is not authentication. Set an exact browser origin if a web client is added.
CORS_ORIGIN=*
